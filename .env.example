# ---------------------------------------------------------------------------
# napfdeal – environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Public base URL (no trailing slash). Used for canonicals, sitemaps, mails.
NEXT_PUBLIC_SITE_URL=https://napfdeal.com

# Port on 127.0.0.1 where the web app listens for the server's existing reverse proxy.
# Check it's free first:  ss -tlnp | grep ':3100 '
WEB_PORT=3100

# If 80/443 belong to a reverse proxy that runs IN DOCKER (e.g. a shared Caddy container):
# join its network so it can reach the app as napfdeal-web:3000. Find the name with
#   docker inspect <proxy-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# COMPOSE_FILE=compose.yaml:compose.edge.yaml
# EDGE_NETWORK=

# Leave empty if the server already has a reverse proxy (nginx, Caddy, Traefik …) on 80/443.
# Set to "caddy" only on a server where 80/443 are free – then napfdeal brings its own HTTPS proxy.
COMPOSE_PROFILES=

# Domain Caddy serves and requests a TLS certificate for (only used with COMPOSE_PROFILES=caddy).
DOMAIN=napfdeal.com
# Let's Encrypt contact address (expiry warnings only).
ACME_EMAIL=napfdeal@gmail.com

# Docker images built by GitHub Actions (lowercase!), e.g. ghcr.io/<github-user>/napfdeal
IMAGE_PREFIX=ghcr.io/CHANGE_ME/napfdeal
IMAGE_TAG=latest

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=napfdeal
POSTGRES_USER=napfdeal
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_ME
# Inside Docker the host is "postgres". For local dev use localhost.
DATABASE_URL=postgres://napfdeal:CHANGE_ME@postgres:5432/napfdeal

# --- Jobs ------------------------------------------------------------------
# Time zone for scheduled jobs (feed imports 05:30 / 17:30 etc.)
JOB_TIMEZONE=Europe/Vienna

# --- Backups (scripts/backup.sh) -------------------------------------------
BACKUP_DIR=/var/backups/napfdeal
BACKUP_RETENTION_DAYS=30
# File containing the GPG passphrase for backup encryption (chmod 600).
BACKUP_PASSPHRASE_FILE=/root/.napfdeal-backup-pass
# Hetzner Storage Box target (rsync over SSH, port 23). Leave empty to skip.
# Example: u123456@u123456.your-storagebox.de:napfdeal
STORAGEBOX_TARGET=

# --- Price feeds -------------------------------------------------------------
# 1 = also import the clearly marked test data from fixtures/awin/ (network "awin-test",
# never shown publicly). Set back to 0 → test data is deleted on the next worker start.
FEEDS_TEST_MODE=0

# Private preview: open https://napfdeal.com/vorschau/<PREVIEW_TOKEN>/ to see test data on the real
# pages (only in your browser). Leave empty to disable. Generate: openssl rand -hex 24
PREVIEW_TOKEN=

# Awin: "API key" for product feeds (Awin → Toolbox → Create-a-Feed). Empty = Awin import off.
AWIN_FEED_KEY=

# --- Accounts (Better Auth) -------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://napfdeal.com

# --- E-Mail (Brevo SMTP + API) -----------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="napfdeal <hallo@napfdeal.com>"
BREVO_API_KEY=
# Local development only: print mails to the log instead of sending (never in production)
MAIL_DEV_LOG=0

# --- Login with Google / Discord (optional; buttons appear when set) --------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord application → OAuth2: Client ID (= Application ID) and Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Later phases -------------------------------------------------------------
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
