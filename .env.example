# ---------------------------------------------------------------------------
# napfdeal – environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Public base URL (no trailing slash). Used for canonicals, sitemaps, mails.
NEXT_PUBLIC_SITE_URL=https://napfdeal.com

# Domain Caddy serves and requests a TLS certificate for.
DOMAIN=napfdeal.com
# Let's Encrypt contact address (expiry warnings only).
ACME_EMAIL=napfdeal@gmail.com

# Docker images built by GitHub Actions (lowercase!), e.g. ghcr.io/<github-user>/napfdeal
IMAGE_PREFIX=ghcr.io/CHANGE_ME/napfdeal
IMAGE_TAG=latest

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=napfdeal
POSTGRES_USER=napfdeal
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_ME
# Inside Docker the host is "postgres". For local dev use localhost.
DATABASE_URL=postgres://napfdeal:CHANGE_ME@postgres:5432/napfdeal

# --- Jobs ------------------------------------------------------------------
# Time zone for scheduled jobs (feed imports 05:30 / 17:30 etc.)
JOB_TIMEZONE=Europe/Vienna

# --- Backups (scripts/backup.sh) -------------------------------------------
BACKUP_DIR=/var/backups/napfdeal
BACKUP_RETENTION_DAYS=30
# File containing the GPG passphrase for backup encryption (chmod 600).
BACKUP_PASSPHRASE_FILE=/root/.napfdeal-backup-pass
# Hetzner Storage Box target (rsync over SSH, port 23). Leave empty to skip.
# Example: u123456@u123456.your-storagebox.de:napfdeal
STORAGEBOX_TARGET=

# --- Later phases (leave empty for now) ------------------------------------
# Phase 1: Awin
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
AWIN_FEED_KEY=
# Phase 3/4: Brevo SMTP + API (contact deletion)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="napfdeal <hallo@napfdeal.com>"
BREVO_API_KEY=
# Phase 3: OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
