# Caddy: automatic HTTPS via Let's Encrypt, reverse proxy to Next.js.
# Deliberately NO access log (data minimisation: no IP addresses on disk).
# Errors still go to stdout and are rotated by Docker.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Long cache for hashed static assets
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
